meta {
  name: Start timer
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/timer/commands
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "commandId": "{{$guid}}",
    "expectedVersion": {{timerVersion}},
    "type": "START"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("timerVersion", res.body.version);
  }
}

assert {
  res.status: eq 200
}

docs {
  Boşta (IDLE) sayacı başlatır. Önce Get timer çalıştır. commandId her çalıştırmada yeni üretilir.
}
