meta {
  name: Resume timer
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/timer/commands
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "commandId": "{{$guid}}",
    "expectedVersion": {{timerVersion}},
    "type": "RESUME"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("timerVersion", res.body.version);
  }
}

assert {
  res.status: eq 200
}

docs {
  Duran sayacı kalan süreden devam ettirir.
}
