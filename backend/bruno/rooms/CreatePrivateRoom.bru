meta {
  name: Create private room
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/rooms
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "Gizli oda",
    "visibility": "PRIVATE",
    "maxMembers": 4
  }
}

assert {
  res.status: eq 201
  res.body.visibility: eq PRIVATE
  res.body.myRole: eq OWNER
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("privateRoomId", res.body.id);
    bru.setEnvVar("inviteCode", res.body.inviteCode);
  }
}

docs {
  Sahip davet kodunu cevapta görür. Kod ortam değişkeni inviteCode olarak kaydedilir.
}
