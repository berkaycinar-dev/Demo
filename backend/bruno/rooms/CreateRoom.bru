meta {
  name: Create public room
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/rooms
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "Algoritma çalışma odası",
    "description": "Birlikte çalışalım",
    "maxMembers": 6
  }
}

assert {
  res.status: eq 201
  res.body.visibility: eq PUBLIC
  res.body.myRole: eq OWNER
  res.body.memberCount: eq 1
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("roomId", res.body.id);
  }
}

docs {
  Önce auth/Login çalıştır (accessToken lazım). Boş bırakılan alanlar: visibility=PUBLIC, maxMembers=8.
}
